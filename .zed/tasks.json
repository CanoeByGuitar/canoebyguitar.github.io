[
  {
    "label": "Manim: Preview current scene",
    "command": "node",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/render-manim.mjs",
      "--mode",
      "preview",
      "--scene-file",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current",
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Manim: Render current still",
    "command": "node",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/render-manim.mjs",
      "--mode",
      "still",
      "--scene-file",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Manim: Render current scene",
    "command": "node",
    "args": [
      "$ZED_WORKTREE_ROOT/scripts/render-manim.mjs",
      "--mode",
      "render",
      "--scene-file",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current",
    "reveal": "always",
    "hide": "on_success"
  }
]
