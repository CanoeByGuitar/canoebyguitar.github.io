---
import Search from '@astrojs/starlight/components/Search.astro';
const base = import.meta.env.BASE_URL;
---

<div class="custom-doc-header">
  <a class="custom-doc-brand" href={base}>
    <span>~/</span><strong>chenhui</strong>
  </a>
  <nav aria-label="Primary">
    <a href={`${base}about/`}>about</a>
    <a href={`${base}posts/`}>posts</a>
  </nav>
  <div class="custom-doc-search"><Search /></div>
  <button class="custom-doc-theme" type="button" data-scheme-toggle data-scheme-label>
    one light
  </button>
</div>

<style>
  .custom-doc-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .custom-doc-brand {
    display: inline-flex;
    gap: 0.4rem;
    color: var(--c-fg);
    text-decoration: none;
  }
  .custom-doc-brand > span {
    color: var(--c-accent);
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  nav a {
    color: var(--c-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--c-accent);
  }
  .custom-doc-search {
    margin-left: auto;
    min-width: min(20rem, 35vw);
  }
  .custom-doc-theme {
    border: 1px solid var(--c-border);
    border-radius: 4px;
    padding: 0.4rem 0.65rem;
    font: inherit;
    color: var(--c-fg);
    background: var(--c-surface);
    cursor: pointer;
  }
  .custom-doc-theme:hover {
    border-color: var(--c-accent);
  }
  @media (max-width: 40rem) {
    nav {
      display: none;
    }
    .custom-doc-search {
      min-width: 0;
    }
    .custom-doc-theme {
      max-width: 7rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
