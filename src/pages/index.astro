---
import '../styles/custom.css';
import avatar from '../assets/avatar.jpg';

const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <title>Chenhui Wang · Physics / Animation</title>
    <meta
      name="description"
      content="Chenhui Wang — physics and animation engine programmer working on computer graphics and physical simulation."
    />
    <meta property="og:title" content="Chenhui Wang" />
    <meta property="og:description" content="Physics / Animation" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('avatar.jpg', Astro.site).href} />
    <meta property="og:image:alt" content="Portrait of Chenhui Wang" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={new URL('avatar.jpg', Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <script is:inline>
      try {
        document.documentElement.dataset.scheme =
          localStorage.getItem('theme-palette') || 'one-light';
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${BASE}`}>
        <span class="brand-prompt">~/</span><span>chenhui</span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href={`${BASE}about/`}>about</a>
        <a href={`${BASE}posts/`}>posts</a>
      </nav>
      <button class="palette-btn" type="button" data-scheme-toggle data-scheme-label>
        one light
      </button>
    </header>

    <main class="container home-main">
      <section class="hero home-hero">
        <img class="avatar home-avatar" src={avatar.src} alt="Chenhui Wang" width="112" height="112" />
        <p class="home-eyebrow">PHYSICS / ANIMATION / GamePlay</p>
        <p class="hero-intro home-intro">
          I am a physics and animation engine programmer interested in computer graphics,
          physical simulation, character animation, and production tools.
        </p>
        <div class="home-actions">
          <a href={`${BASE}about/`}>about</a>
          <a href={`${BASE}posts/`}>posts</a>
          <a href="mailto:canoebyguitar@gmail.com">email</a>
          <a href="https://github.com/canoeByGuitar" target="_blank" rel="noopener">github</a>
        </div>
      </section>
    </main>

    <footer class="site-footer home-footer">
      <span>Chenhui Wang · canoebyguitar@gmail.com</span>
    </footer>

    <script src={`${BASE}theme.js`} defer></script>
  </body>
</html>
